# --- Database ---
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfinder
# Local dev targets the PostgreSQL installed on the machine (created by `npm run db:setup`).
DATABASE_URL=postgresql://jobfinder:change-me@localhost:5432/jobfinder

# --- API ---
PORT=3001
CORS_ORIGIN=http://localhost:4201

# --- App access (optional, skipped when empty: app stays open) ---
# At least 8 characters when set.
APP_PASSWORD=

# --- Docker only: host port of the app (nginx) ---
# Kept off 80/8080/8501 so it does not collide with another server on the machine
# (a Streamlit app for instance). CORS_ORIGIN must use this same port in Docker.
HTTP_PORT=8480
# Ports for the optional (commented) host publications of the db and the api in
# docker-compose.yml, both bound to 127.0.0.1.
POSTGRES_HOST_PORT=55432
API_HOST_PORT=3480

# --- France Travail (required) ---
# https://francetravail.io -> create an app -> subscribe to "Offres d'emploi v2"
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna (optional, skipped when empty) ---
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- OpenRouteService (only needed to regenerate the 45min isochrone) ---
# https://openrouteservice.org/dev
ORS_API_KEY=

# --- Search profile: the trade (comma-separated lists) ---
# Free-text queries sent to every source, one concept per entry (France Travail ANDs the
# words of a query, so "développeur full stack" returns nothing). Adzuna only uses the
# first three to stay within its free quota.
SEARCH_KEYWORDS=développeur,ingénieur logiciel,full stack,angular,java,typescript,node.js
# ROME code of the trade, France Travail only (optional). M1805 = software development.
SEARCH_ROME_CODE=M1805
# The title must contain one of these (accents ignored) and none of the excluded ones.
SEARCH_TITLE_INCLUDE=developpeur,developer,devellopeur,ingenieur logiciel,ingenieur etude,ingenieur d etude,ingenieur informatique,concepteur developpeur,software engineer,lead dev,tech lead,full stack,fullstack,back end,backend,front end,frontend,analyste programmeur
SEARCH_TITLE_EXCLUDE=alternance,alternant,apprenti,stage,stagiaire,business developer,business development,commercial,freelance,independant,portage salarial
# The ad must mention one of these technologies, otherwise it is dropped.
SEARCH_STACK_KEYWORDS=angular,java,jee,j2ee,spring,spring boot,typescript,node,nodejs,node js,node.js,nestjs,full stack,fullstack

# --- Search area: where on-site offers are accepted ---
# Name of the on-site tab in the UI.
SEARCH_AREA_LABEL=Seine-Maritime
# Centre of the commuting area, "lat,lng" in decimal degrees (Le Havre town hall here).
SEARCH_AREA_CENTER=49.4938,0.1077
# Driving time from the centre. The isochrone is generated for this value
# (`npm run geo:isochrone`, see README); ORS times are pessimistic, 55 is a real 45.
SEARCH_AREA_DRIVE_MINUTES=55
# City name for sources searching by place (Adzuna) and its INSEE code (France Travail).
SEARCH_AREA_CITY=Le Havre
SEARCH_AREA_INSEE=76351
# NUTS-2 region code for EURES, which only locates offers at region level. FRD2 = Haute-Normandie.
SEARCH_AREA_EURES_REGION=FRD2

# --- Ingestion ---
# Cron expression, default: every 2 hours
INGESTION_CRON=0 0 */2 * * *
# Run one ingestion right after boot
INGESTION_ON_STARTUP=false
# Offers not seen for this many days are deleted, favourites excepted
INGESTION_STALE_DAYS=30
