# Template: at startup the image fills in ${BACKEND_URL} and ${NGINX_LOCAL_RESOLVERS}, every lowercase $name is nginx's.

# Scheme the client used, as told by the proxy in front, or this connection's when nothing is in front.
map $http_x_forwarded_proto $forwarded_proto {
	default $http_x_forwarded_proto;
	"" $scheme;
}

server {
	# Unprivileged image: the worker cannot bind a port below 1024.
	listen 8080;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;
	# No nginx version in the Server header and error pages.
	server_tokens off;

	gzip on;
	gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

	# Only the proxy in front (or the stack's own network) reaches this port, so its X-Forwarded-For is the
	# one to trust: the real client is resolved from it before anything reads $remote_addr.
	set_real_ip_from 127.0.0.1;
	set_real_ip_from 10.0.0.0/8;
	set_real_ip_from 172.16.0.0/12;
	set_real_ip_from 192.168.0.0/16;
	real_ip_header X-Forwarded-For;
	real_ip_recursive on;

	# Private job watch: never indexed. Every location sets its own headers, because one add_header in
	# a location drops all those of the server block. HSTS belongs to whatever terminates HTTPS in front.

	# Resolved per request, so nginx starts and answers even while the backend is down or not created yet.
	resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
	set $backend ${BACKEND_URL};

	# One origin for the whole app: whatever sits in front only routes the domain to this port.
	# `^~` so no regex location below (bundles, fonts) ever catches an API path.
	location ^~ /api/ {
		proxy_pass $backend;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		# Overwritten, not appended: the API trusts a single hop for its login throttle, so it must
		# receive exactly one address, the client resolved above, never a spoofed prefix.
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $forwarded_proto;
		# A manual ingestion reads every source and can take a couple of minutes.
		proxy_read_timeout 300s;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		# Down is not slow: a timeout means the API is still working, the run may well finish.
		error_page 502 = @backend-down;
		error_page 504 = @backend-slow;
	}

	# Public uptime probe: the API and its database.
	location = /readyz {
		proxy_pass $backend;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header Cache-Control "no-store" always;
		error_page 502 504 = @backend-down;
	}

	# Backend unreachable: a JSON ApiError rather than an HTML error page, so the app says why.
	location @backend-down {
		# Empty map: the JSON type even for a path ending in .js or .css.
		types { }
		default_type application/json;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "no-store" always;
		return 503 '{"status":503,"code":"UNAVAILABLE","detail":"The job-finder server is not running."}';
	}

	# Backend too slow for proxy_read_timeout: nginx gave up waiting, the request may still complete.
	location @backend-slow {
		# Empty map: the JSON type even for a path ending in .js or .css.
		types { }
		default_type application/json;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "no-store" always;
		return 504 '{"status":504,"code":"TIMEOUT","detail":"The job-finder server took too long; the operation may still be running."}';
	}

	# Liveness of nginx for the Docker healthcheck and the uptime probe; kept out of the access log.
	location = /healthz {
		access_log off;
		default_type text/plain;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header Cache-Control "no-store" always;
		return 200 'ok';
	}

	# Hashed bundles never change under a given URL. Cache-Control without `always`: a bundle gone with
	# a deployment answers a 404 that must not be cached for a year.
	location ~* \.(?:js|css)$ {
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "public, max-age=31536000, immutable";
	}

	# Self-hosted fonts keep their file name across deployments: cached a week, like the app icons.
	location /fonts/ {
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "public, max-age=604800";
		try_files $uri =404;
	}

	# Glyphs: a missing one is a 404, never the SPA shell served as an image.
	location /assets/ {
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "no-cache" always;
		try_files $uri =404;
	}

	# Manifest: read again on every install, so a colour change reaches the installed app within the hour.
	location = /manifest.webmanifest {
		types {
			application/manifest+json webmanifest;
		}
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "public, max-age=3600";
		try_files $uri =404;
	}

	# App icons keep their URL across deployments: cached a week, so a new logo still lands.
	location ~* ^/(?:favicon\.ico|icon\.svg|icons/[^/]+\.png)$ {
		types {
			image/x-icon ico;
			image/svg+xml svg;
			image/png png;
		}
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "public, max-age=604800";
		try_files $uri =404;
	}

	# SPA shell: names the hashed bundles, so never cached; unknown paths fall back to it.
	# CSP limits the damage of an XSS; styles need 'unsafe-inline' for Angular component styles.
	location / {
		add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Cache-Control "no-cache" always;
		try_files $uri /index.html;
	}
}
