generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer accepts `url` here).
datasource db {
  provider = "postgresql"
}

enum JobSourceType {
  FRANCE_TRAVAIL
  ADZUNA
  ATS
  EURES
  APEC
  FREE_WORK
  JOOBLE
}

model Job {
  id          String        @id @default(cuid())
  source      JobSourceType
  sourceId    String
  /// Human readable origin, e.g. "France Travail" or "Doctolib (Greenhouse)".
  sourceLabel String

  title              String
  company            String?
  companyDescription String?
  description        String?
  /// False when the source only exposes a truncated description: the UI flags it as an excerpt.
  hasFullDescription Boolean @default(false)
  contractLabel      String?
  salary             String?

  city                  String?
  postalCode            String?
  isRemote              Boolean @default(false)
  /// True when only the region is known, so the commute is unverified.
  isLocationApproximate Boolean @default(false)

  isViewed Boolean @default(false)

  url             String
  /// Links to the same offer found on other sources during deduplication.
  alternativeUrls String[] @default([])

  /// With firstSeenAt as fallback, the age that drives the purge.
  publishedAt DateTime?
  firstSeenAt DateTime  @default(now())

  /// Similarity key used to merge the same offer republished across sources.
  dedupeHash String
  isFavorite Boolean @default(false)

  @@unique([source, sourceId])
  @@index([dedupeHash])
  @@index([isRemote, publishedAt])
  @@index([isFavorite])
}

/// Avoids re-geocoding the same place on every ingestion run. Null coordinates cache a place the
/// address base does not know; a lookup that failed is never cached.
model GeocodeCache {
  query      String   @id
  latitude   Float?
  longitude  Float?
  city       String?
  postalCode String?
  createdAt  DateTime @default(now())
}

model IngestionRun {
  id         String    @id @default(cuid())
  source     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  fetched    Int       @default(0)
  kept       Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  error      String?

  @@index([startedAt])
  @@index([source, startedAt])
}

/// Single-row table holding the scrypt hash of the shared app password.
/// No row means the app is open (no login screen).
model AppPassword {
  id        Int      @id @default(1)
  hash      String
  updatedAt DateTime @updatedAt
}

/// Login session. The browser holds the random token; only its SHA-256 is stored.
model Session {
  tokenHash String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
