# =============================================================================
# Local development settings: `cp .env.example .env` and the backend starts as is.
# Every source without credentials is skipped, never failed: fill them in when you want its offers.
# Never deploy this file: a server sets its own variables (docs/deployment.md).
# =============================================================================

# =============================================================================
# Database
# =============================================================================
# PostgreSQL of compose.yaml (`make db`), published on 5434 so it never clashes with a native install
# or with another project's database on 5433. Native PostgreSQL instead (backend README): port 5432 and
# your role's password, e.g. postgresql://jobfinder:<password>@localhost:5432/jobfinder.
DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5434/jobfinder

# =============================================================================
# API
# =============================================================================
# Off the usual 3000/8080, so the API runs next to other projects; the app's dev server proxies to it.
PORT=3001

# Origins allowed to call the API from a browser, comma-separated: the Angular dev server.
CORS_ORIGIN=http://localhost:4201

# =============================================================================
# Source credentials
# =============================================================================
# France Travail: https://francetravail.io, create an app, subscribe to "Offres d'emploi v2".
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: https://fr.jooble.org/api/about, the key is sent by e-mail.
JOOBLE_API_KEY=

# OpenRouteService, only to regenerate the commute isochrone (`npm run geo:isochrone`): https://openrouteservice.org/dev
ORS_API_KEY=

# =============================================================================
# Search profile: the trade (comma-separated lists)
# =============================================================================
# Free-text queries sent to every source, one concept per entry (France Travail ANDs the
# words of a query, so "développeur full stack" returns nothing). Adzuna only uses the
# first three to stay within its free quota.
# Quoted: an unquoted "#" would start a comment and truncate the list.
# Spelled as the app shows them on each offer; matching ignores case and accents.
SEARCH_KEYWORDS="développeur,ingénieur études,ingénieur logiciel,concepteur développeur,analyste programmeur,software engineer,full stack,angular,java,typescript,node.js,c#,.net,php,symfony,vue.js,python"
# ROME code of the trade, France Travail only (optional). M1805 = software development.
SEARCH_ROME_CODE=M1805
# The title must contain one of these (accents ignored) and none of the excluded ones.
SEARCH_TITLE_INCLUDE=developpeur,developpeuse,developer,devellopeur,developpement,ingenieur logiciel,ingenieur etude,ingenieur etudes,ingenieur d etude,ingenieur d etudes,ingenieur informatique,ingenieur developpement,ingenieur applicatif,ingenieur r&d,concepteur developpeur,software engineer,software developer,lead dev,lead developer,tech lead,full stack,fullstack,back end,backend,front end,frontend,analyste programmeur,programmeur,architecte logiciel,architecte applicatif,architecte technique,expert technique,consultant technique
SEARCH_TITLE_EXCLUDE=alternance,alternant,apprenti,apprentissage,stage,stagiaire,business developer,business development,developpement commercial,developpeur commercial,commercial,commerciale,vente,vendeur,technico commercial,chef de secteur,freelance,independant,portage salarial,formateur,enseignant,professeur,recrutement,chargee de recrutement,charge de recrutement,etudes de prix,etude de prix,genie civil,vrd,cvc,ventilation,thermique,batiment,mecanique,mecaniques,electrique,electricite,nucleaire,ferroviaire,automatisme,hydraulique,acoustique,geotechnique,bureau d etudes,conducteur de travaux
# The ad must mention one of these technologies, otherwise it is dropped.
# Quoted: an unquoted "#" would start a comment and truncate the list.
# Spelled as the app shows them on each offer; matching ignores case and accents.
SEARCH_STACK_KEYWORDS="Angular,AngularJS,Java,JEE,J2EE,Jakarta EE,Spring,Spring Boot,Quarkus,Hibernate,Kotlin,Scala,TypeScript,JavaScript,Node,NodeJS,Node JS,Node.js,NestJS,VueJS,Vue JS,Vue.js,Vue 3,Nuxt,C#,CSharp,.NET,dotnet,ASP.NET,Blazor,PHP,Symfony,Laravel,Python,Django,FastAPI,Golang,API REST,REST API,microservices,full stack,fullstack"

# =============================================================================
# Search area: where on-site offers are accepted
# =============================================================================
# Name of the on-site tab in the UI.
SEARCH_AREA_LABEL=Normandie
# Centre of the commuting area, "lat,lng" in decimal degrees (Le Havre town hall here).
SEARCH_AREA_CENTER=49.4938,0.1077
# Road distance from the centre. The isochrone is generated for this value
# (`npm run geo:isochrone`, see README); 100 km reaches Caen, Rouen and Dieppe.
SEARCH_AREA_DRIVE_KM=100
# City name for sources searching by place (Adzuna) and its INSEE code (France Travail).
SEARCH_AREA_CITY=Le Havre
SEARCH_AREA_INSEE=76351
# NUTS-2 region codes for EURES, which only locates offers at region level.
# FRD1 = Basse-Normandie (Caen), FRD2 = Haute-Normandie (Le Havre, Rouen).
SEARCH_AREA_EURES_REGIONS=FRD1,FRD2
# APEC macro-region id (`lieux`): 799 = France, 800 = Ile-de-France, 801 = Grand Ouest
# (Normandie, Bretagne, Pays de la Loire, Centre), 802 = Nord-Est, 803 = Sud-Est, 804 = Sud-Ouest.
SEARCH_AREA_APEC_LOCATION=801
# Free-Work location keys, "fr~<region>~<department>~<city>", empty segments widen the scope.
SEARCH_AREA_FREE_WORK_LOCATIONS=fr~normandie~~

# =============================================================================
# Ingestion
# =============================================================================
# Cron expression with seconds; every 2 hours by default.
INGESTION_CRON=0 0 */2 * * *

# One run right after boot. Off in development: a restart would crawl every source again.
INGESTION_ON_STARTUP=false

# Offers not seen for this many days are deleted, favourites excepted.
INGESTION_STALE_DAYS=30

# Uptime-kuma push monitor pinged after every run, `status=down` when a source failed or the run
# crashed, so the monitor alerts; it also alerts when the pings stop. Empty turns it off.
INGESTION_HEARTBEAT_URL=

# =============================================================================
# Development switches
# =============================================================================
# Turns the login throttle off, so repeated sign-ins never lock you out: development and the demo
# only, never in production (unset, it is on).
LOGIN_THROTTLE_ENABLED=false
