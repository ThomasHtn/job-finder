{
  "name": "backend",
  "version": "1.0.0",
  "description": "Job aggregator API: sources, ingestion, filters, REST",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed-demo": "tsx src/cli/seed-demo.ts",
    "auth:set-password": "tsx src/cli/set-password.ts",
    "geo:isochrone": "tsx src/cli/generate-isochrone.ts"
  },
  "dependencies": {
    "@job-finder/contract": "*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
